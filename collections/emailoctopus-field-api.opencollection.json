            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update field"
        },
        {
          "info": {
            "name": "Delete field",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.emailoctopus.com/lists/:list_id/fields/:tag",
            "params": [
              {
                "name": "list_id",
                "value": "",
                "type": "path",
                "description": "The ID of the list."
              },
              {
                "name": "tag",
                "value": "",
                "type": "path",
                "description": "The tag identifier."
              }
            ]
